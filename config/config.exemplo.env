# Copia este ficheiro para ~/.meta-ads/config.env (fora do repositório) e preenche.
# Nunca coloques o token dentro da pasta do repositório nem o envies por mensagem.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_PIXEL_ID=
META_PAGE_ID=
# Opcional: conta de Instagram ligada à página (para os anúncios saírem com o @ do Instagram)
META_INSTAGRAM_ID=
